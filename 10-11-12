<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سیستمی زیندەزانی - ئامادەیی</title>
    <style>
        body { font-family: Tahoma, Arial, sans-serif; background-color: #f3f4f6; margin: 0; padding: 20px; }
        .container { max-width: 600px; margin: auto; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h2 { color: #2c3e50; text-align: center; border-bottom: 2px solid #3498db; padding-bottom: 10px; }
        input, select, button { width: 100%; padding: 12px; margin: 10px 0; border-radius: 6px; border: 1px solid #ccc; box-sizing: border-box; font-size: 15px; }
        button { background-color: #3498db; color: white; border: none; cursor: pointer; font-weight: bold; font-size: 16px; }
        button:hover { background-color: #2980b9; }
        .hidden { display: none; }
        .card { background: #fdfdfd; border: 1px solid #e1e8ed; padding: 15px; border-radius: 8px; margin-bottom: 15px; }
        .notification { background: #e74c3c; color: white; padding: 12px; border-radius: 6px; margin-bottom: 15px; font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #bdc3c7; padding: 10px; text-align: center; }
        th { background-color: #2c3e50; color: white; }
        .material-link { display: inline-block; padding: 8px 15px; background: #2ecc71; color: white; text-decoration: none; border-radius: 5px; margin-top: 5px; font-size: 14px; }
        .material-link:hover { background: #27ae60; }
        .material-item { border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 10px; }
        .material-item:last-child { border-bottom: none; }
    </style>
</head>
<body>

<!-- بەشی چوونەژوورەوە -->
<div class="container" id="login-section">
    <h2>سیستمی خوێندکاران - زیندەزانی</h2>
    <p style="text-align:center; color:#7f8c8d;">تکایە پۆلەکەت هەڵبژێرە و یوزەرنەیم و پاسوۆردەکەت بنووسە</p>
    
    <!-- هەڵبژاردنی پۆل -->
    <select id="grade-level">
        <option value="10">پۆلی ١٠ی زانستی</option>
        <option value="11">پۆلی ١١ی زانستی</option>
        <option value="12">پۆلی ١٢ی زانستی</option>
    </select>

    <input type="text" id="username" placeholder="یوزەرنەیم (بۆ نموونە: BIO102)">
    <input type="password" id="password" placeholder="پاسوۆرد">
    <button onclick="login()">چوونەژوورەوە</button>
    <p id="error-msg" style="color:#e74c3c; text-align:center; font-weight:bold;" class="hidden">زانیارییەکان هەڵەن، تکایە دڵنیابەرەوە!</p>
    <p id="loading-msg" style="color:#3498db; text-align:center;" class="hidden">چاوەڕێ بکە، داتاکان دەهێنرێن...</p>
</div>

<!-- داشبۆردی خوێندکار -->
<div class="container hidden" id="dashboard-section">
    <h2>بەخێربێیت، <span id="student-name" style="color:#2980b9;"></span></h2>
    <p style="text-align:center; color:#7f8c8d;" id="student-grade-display"></p>
    
    <!-- بەشی ئاگادارکردنەوە -->
    <div id="notification-area" class="hidden">
        <div class="notification" id="notification-text"></div>
    </div>

    <!-- بەشی نمرەکان -->
    <div class="card">
        <h3 style="margin-top:0; color:#2c3e50;">📊 نمرەکان</h3>
        <table>
            <tr>
                <th>وەرزی یەکەم</th>
                <th>وەرزی دووەم</th>
                <th>تێکڕای گشتی</th>
            </tr>
            <tr>
                <td id="grade-s1" style="font-weight:bold;">-</td>
                <td id="grade-s2" style="font-weight:bold;">-</td>
                <td id="grade-total" style="font-weight:bold; color:#27ae60;">-</td>
            </tr>
        </table>
    </div>

    <!-- بەشی وانەکان و PDF -->
    <div class="card">
        <h3 style="margin-top:0; color:#2c3e50;">📚 بابەتەکان و ڤیدیۆکان</h3>
        <div id="materials-list">
            <!-- وانەکان لە ڕێگەی سکریپتەوە لێرەدا دادەنرێن -->
        </div>
    </div>
    
    <button style="background-color: #e74c3c; margin-top: 20px;" onclick="logout()">دەرچوون لە سیستم</button>
</div>

<script>
    // تێبینی: لێرەدا لینکی Web App ەکەی گۆگڵ سکرێپت دابنێ لە ناو جووتە کۆتەیشنەکاندا
    const SCRIPT_URL = "لێرەدا_لینکی_گۆگڵ_سکرێپتەکەت_دابنێ";

    function login() {
        const grade = document.getElementById("grade-level").value;
        const user = document.getElementById("username").value.trim();
        const pass = document.getElementById("password").value.trim();
        
        if(!user || !pass) {
            alert("تکایە یوزەرنەیم و پاسوۆرد پڕبکەرەوە");
            return;
        }

        document.getElementById("error-msg").classList.add("hidden");
        document.getElementById("loading-msg").classList.remove("hidden");

        // پەیوەندیکردن بە گۆگڵ شیت بۆ دڵنیابوونەوە لە یوزەر، پاسوۆرد، وە پۆل
        fetch(SCRIPT_URL + "?action=login&grade=" + grade + "&username=" + encodeURIComponent(user) + "&password=" + encodeURIComponent(pass))
        .then(res => res.json())
        .then(data => {
            document.getElementById("loading-msg").classList.add("hidden");
            
            if(data.status === "success") {
                // شاردنەوەی فۆڕمی لۆگین و پیشاندانی داشبۆرد
                document.getElementById("login-section").classList.add("hidden");
                document.getElementById("dashboard-section").classList.remove("hidden");
                
                // پیشاندانی پۆلەکە
                document.getElementById("student-grade-display").innerText = "خوێندکاری پۆلی " + grade + "ی زانستی";

                // جێگیرکردنی ناو و نمرەکان
                document.getElementById("student-name").innerText = data.studentName;
                document.getElementById("grade-s1").innerText = data.season1 || "-";
                document.getElementById("grade-s2").innerText = data.season2 || "-";
                document.getElementById("grade-total").innerText = data.finalGrade || "-";
                
                // جێگیرکردنی ئاگادارکردنەوە (ئەگەر هەبێت)
                if(data.notification && data.notification !== "") {
                    document.getElementById("notification-area").classList.remove("hidden");
                    document.getElementById("notification-text").innerText = "🔔 تێبینی: " + data.notification;
                }
                
                // جێگیرکردنی بابەتەکان
                const materialsDiv = document.getElementById("materials-list");
                materialsDiv.innerHTML = "";
                if(data.materials && data.materials.length > 0) {
                    data.materials.forEach(mat => {
                        materialsDiv.innerHTML += `
                        <div class="material-item">
                            <b>${mat.title}</b> <br> 
                            <a href="${mat.link}" target="_blank" class="material-link">کردنەوەی بابەت / ڤیدیۆ</a>
                        </div>`;
                    });
                } else {
                    materialsDiv.innerHTML = "<p style='color:#7f8c8d;'>هیچ بابەتێک بوونی نییە لە ئێستادا.</p>";
                }
            } else {
                // ئەگەر پاسوۆردەکە هەڵە بوو
                document.getElementById("error-msg").classList.remove("hidden");
            }
        })
        .catch(err => {
            document.getElementById("loading-msg").classList.add("hidden");
            alert("کێشەیەک هەیە لە پەیوەندی هێڵی ئینتەرنێت. تکایە دووبارە هەوڵبدەرەوە.");
            console.error(err);
        });
    }

    function logout() {
        document.getElementById("dashboard-section").classList.add("hidden");
        document.getElementById("login-section").classList.remove("hidden");
        document.getElementById("username").value = "";
        document.getElementById("password").value = "";
        document.getElementById("notification-area").classList.add("hidden");
    }
</script>

</body>
</html>
